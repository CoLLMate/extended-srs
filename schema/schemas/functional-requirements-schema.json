    "processingStep": {
      "type": "object",
      "required": [
        "id",
        "actor",
        "description",
        "next"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "ステップID",
          "description": "処理ステップの一意識別子。推奨：処理内容を表す名前（例：validate-input、call-api、show-results）"
        },
        "actor": {
          "type": "string",
          "title": "アクター",
          "description": "実行主体（事前定義されたアクター名）"
        },
        "description": {
          "type": "string",
          "title": "説明",
          "description": "アクションや処理の内容"
        },
        "preconditions": {
          "$ref": "#/definitions/preconditions"
        },
        "screen_ui": {
          "$ref": "#/definitions/screenUIReference"
        },
        "api_reference": {
          "type": "string",
          "title": "API参照",
          "description": "関連するAPIのID"
        },
        "validations": {
          "type": "array",
          "title": "検証ルール",
          "description": "このステップで実行される検証",
          "items": {
            "$ref": "#/definitions/stepValidation"
          }
        },
        "external_service": {
          "$ref": "#/definitions/externalServiceCall"
        },
        "business_errors": {
          "type": "array",
          "title": "ビジネスエラー",
          "description": "このステップで発生する可能性のあるビジネスエラーと対処",
          "items": {
            "$ref": "#/definitions/businessError"
          }
        },
        "next": {
          "type": "array",
          "title": "次のステップ",
          "description": "遷移先の定義（エラー時の遷移も含む）",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/nextStep"
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "screenUIReference": {
      "type": "object",
