{
  "$comment": "Copyright (c) 2026 CoLLMate, Inc. SPDX-License-Identifier: Apache-2.0",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://exsrs.org/extended-srs/v1/schemas/functional-requirements.json",
  "type": "object",
  "title": "機能要件",
  "description": "システムが提供する機能の詳細定義",
  "properties": {
