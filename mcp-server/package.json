{
  "name": "extended-srs-mcp-server",
  "version": "1.0.1",
  "private": true,
  "description": "MCP server for Extended SRS validation and aggregation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoLLMate/extended-srs.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/CoLLMate/extended-srs/tree/main/mcp-server#readme",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "extended-srs-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && chmod +x dist/index.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:coverage": "c8 node --test --test-reporter=spec test/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "extended-srs",
    "mcp",
    "claude-code",
    "validation"
  ],
  "author": "CoLLMate, Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "extended-srs-core": "file:../extended-srs-core",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "c8": "^12.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    ".c8rc.json",
    "test",
    "scripts"
  ]
}
