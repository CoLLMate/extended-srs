{
  "name": "extended-srs-core",
  "version": "1.0.0",
  "private": true,
  "description": "Core library for Extended SRS validation and aggregation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoLLMate/extended-srs.git",
    "directory": "extended-srs-core"
  },
  "homepage": "https://github.com/CoLLMate/extended-srs/tree/main/extended-srs-core#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "api": [
        "dist/api/index.d.ts"
      ],
      "i18n": [
        "dist/i18n/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "pretest": "npm run build",
    "pretest:coverage": "npm run build",
    "pretest:watch": "npm run build",
    "prebuild": "node scripts/prepare-package.mjs",
    "prewatch": "node scripts/prepare-package.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "extended-srs",
    "srs",
    "validation",
    "requirements"
  ],
  "author": "CoLLMate, Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.0.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "tsconfig.json",
    "LICENSE",
    "README.md",
    "schema",
    "test",
    "vitest.config.mts"
  ]
}
