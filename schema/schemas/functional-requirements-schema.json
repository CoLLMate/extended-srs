        },
        "timeout": {
          "type": "number",
          "title": "タイムアウト",
          "description": "ミリ秒単位"
        },
        "retry": {
          "type": "number",
          "title": "リトライ回数",
          "description": "再試行回数"
        },
        "async": {
          "type": "boolean",
