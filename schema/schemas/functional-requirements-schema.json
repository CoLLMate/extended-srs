      "type": "array",
      "title": "データモデル",
      "description": "システムで使用するデータの定義",
      "items": {
        "$ref": "#/definitions/dataModel"
      }
    },
    "requirements": {
      "type": "array",
      "title": "個別の機能要件リスト",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/functionalRequirement"
      }
    }
  },
  "definitions": {
    "dataModel": {
      "type": "object",
      "required": [
        "data_id",
        "name",
        "type",
        "attributes"
      ],
      "properties": {
        "data_id": {
          "type": "string",
          "title": "データID",
          "description": "データモデルの一意識別子。推奨：意味のある名前（例：user-profile、order-items）"
        },
        "name": {
          "type": "string",
          "title": "データ名",
          "description": "データモデルの名称（ビジネス名）"
        },
        "system_name": {
          "type": "string",
          "title": "システム名",
          "description": "システム実装時の名称（オプション）"
        },
        "type": {
          "type": "string",
          "enum": [
            "master",
            "transaction",
            "reference",
            "log"
          ],
          "title": "タイプ",
          "description": "master/transaction/reference/log"
        },
        "attributes": {
          "type": "array",
          "title": "属性",
          "description": "データ項目の定義",
          "items": {
            "$ref": "#/definitions/dataAttribute"
          }
        },
        "characteristics": {
          "$ref": "#/definitions/dataCharacteristics"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "dataAttribute": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "属性名",
          "description": "項目の識別名（ビジネス名）"
        },
        "system_name": {
          "type": "string",
          "title": "システム名",
          "description": "実装時の名称（オプション）"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "datetime",
            "uuid",
            "id",
            "integer",
            "decimal",
            "float",
            "enum",
            "json",
            "array"
          ],
          "title": "データ型",
          "description": "データ型定義"
        },
        "required": {
          "type": "boolean",
          "title": "必須",
          "description": "true/false"
        },
        "description": {
          "type": "string",
          "title": "説明",
          "description": "属性の意味"
        },
        "max_length": {
          "type": "number",
          "title": "最大長",
          "description": "文字列型の場合"
        },
        "precision": {
          "type": "number",
          "title": "精度",
          "description": "decimal型の場合の全体桁数"
        },
        "scale": {
          "type": "number",
          "title": "スケール",
          "description": "decimal型の場合の小数点以下桁数"
        },
        "values": {
          "type": "array",
          "title": "値リスト",
          "description": "enum型の場合の選択肢",
          "items": {
            "type": "string"
          }
        },
        "default": {
          "title": "デフォルト値",
          "description": "初期値"
        },
        "conversion": {
          "type": "string",
          "title": "変換",
          "description": "データ変換ルール（オプション）"
        },
        "constraints": {
          "type": "array",
          "title": "制約",
          "description": "データ制約条件",
          "items": {
            "type": "string",
            "description": "制約条件（primary_key/unique/not_null/foreign_key等）"
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "dataCharacteristics": {
      "type": "object",
      "title": "データ特性",
      "description": "データの運用特性",
      "properties": {
        "update_frequency": {
          "type": "string",
          "title": "更新頻度",
          "description": "更新タイミング"
        },
        "volume": {
          "type": "string",
          "title": "データ量",
          "description": "想定件数や容量"
        },
        "retention": {
          "type": "string",
          "title": "保存期間",
          "description": "データ保管期間"
        },
        "partitioning": {
          "type": "string",
          "title": "パーティション",
          "description": "分割方法"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "functionalRequirement": {
      "type": "object",
      "required": [
        "req_id",
        "name",
        "priority",
        "acceptance_criteria"
      ],
      "properties": {
        "req_id": {
          "type": "string",
          "title": "要件ID",
          "description": "機能要件の一意識別子。推奨：機能を表す意味のある名前（例：user-registration、product-search）"
        },
        "name": {
          "type": "string",
          "title": "要件名",
          "description": "機能の名称"
        },
        "priority": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "could",
            "wont",
            "high",
            "medium",
            "low"
          ],
          "title": "優先度",
          "description": "high/medium/low"
        },
        "actors": {
          "type": "array",
          "title": "アクター",
          "description": "この機能に関わるアクター名のリスト",
          "items": {
            "type": "string"
          }
        },
        "used_data": {
          "type": "array",
          "title": "使用データ",
          "description": "この機能で使用するデータIDの参照",
          "items": {
            "type": "string"
          }
        },
        "processing_details": {
          "$ref": "#/definitions/processingDetails"
        },
        "ui_specifications": {
          "type": "array",
          "title": "UI仕様",
          "description": "ユーザーインターフェースの定義",
          "items": {
            "$ref": "#/definitions/uiSpecification"
          }
        },
        "acceptance_criteria": {
          "$ref": "#/definitions/functionalAcceptanceCriteria"
        },
        "status": {
          "$ref": "common-definitions-schema.json#/definitions/status"
        },
        "tags": {
          "$ref": "common-definitions-schema.json#/definitions/tags"
        },
        "depends_on": {
          "$ref": "common-definitions-schema.json#/definitions/dependsOn"
        },
        "blocks": {
          "$ref": "common-definitions-schema.json#/definitions/blocks"
        },
        "traceability": {
          "$ref": "#/definitions/traceability"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "processingDetails": {
      "type": "object",
      "title": "処理詳細",
      "description": "処理の詳細仕様",
      "properties": {
        "preconditions": {
          "$ref": "#/definitions/preconditions"
        },
        "postconditions": {
          "type": "array",
          "title": "事後条件",
          "description": "実行後に保証される状態のリスト",
          "items": {
            "type": "string"
