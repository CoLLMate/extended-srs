          }
        },
        "alternative_flows": {
          "type": "array",
          "title": "代替フロー",
          "description": "分岐処理のグループ",
          "items": {
            "$ref": "#/definitions/namedFlow"
          }
        },
        "exception_flows": {
          "type": "array",
